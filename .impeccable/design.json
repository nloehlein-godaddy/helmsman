      "html": "<button class=\"ds-primary\">Save settings</button>",
      "css": ".ds-primary{font:14px/1.4 var(--sans,system-ui,sans-serif);border-radius:6px;min-height:36px;padding:6px 12px;cursor:pointer;transition:background-color 160ms ease-out,border-color 160ms ease-out;background:var(--accent);color:var(--on-accent);border:1px solid var(--accent);font-weight:600;}.ds-primary:hover:not(:disabled){background:var(--accent-bright);border-color:var(--accent-bright);}.ds-primary:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}.ds-primary:disabled{opacity:.5;cursor:default;}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none;}}"
    },
