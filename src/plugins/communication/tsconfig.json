{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "noEmitOnError": true
  },
  "include": [
    "page.ts",
    "header.ts",
    "notifications.ts",
    "notification-view.ts",
    "review-request.ts",
    "settings.ts",
    "util.ts",
    "styles.ts"
  ]
}
