{
  "packageVersion": 1,
  "manifest": {
    "manifestVersion": 2,
    "id": "example.helm",
    "version": "0.1.0",
    "sdkVersion": 1,
    "pages": [
      {
        "id": "page",
        "title": "Workspace",
        "slots": [
          "helmsman/helm-page"
        ],
        "panes": [],
        "composition": {
          "id": "helmsman/helm-page",
          "version": 1,
          "accepts": [
            {
              "id": "helmsman/helm-panel",
              "version": 1
            }
          ],
          "initialLayout": {
            "instances": [
              {
                "instanceId": "queue",
                "contributionId": "example.backlog/panel"
              }
            ],
            "columns": [
              [
                {
                  "instances": [
                    "queue"
                  ],
                  "activeInstanceId": "queue",
                  "collapsed": false
                }
              ]
            ]
          }
        },
        "requires": [
          {
            "id": "helmsman/composition",
            "version": 1
          }
        ]
      }
    ],
    "panels": []
  },
  "node": {
    "minMajor": 22,
    "maxMajorExclusive": 30
  },
  "entries": {
    "page": "page.js"
  },
  "panelEntries": {}
}
