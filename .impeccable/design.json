      "kind": "nav",
      "refersTo": "page-tab",
      "description": "Evergreen destination navigation.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Pages\"><a class=\"ds-nav-link ds-nav-active\" href=\"#helm\" aria-current=\"page\">Helm</a><a class=\"ds-nav-link\" href=\"#runs\">Runs</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:4px;padding:24px 12px;background:var(--nav-bg);width:176px}.ds-nav-link{font:500 13px/1.4 var(--sans,system-ui,sans-serif);color:var(--nav-muted);border:1px solid transparent;border-radius:6px;padding:10px 14px;text-decoration:none}.ds-nav-link:hover,.ds-nav-active{color:var(--nav-text);background:var(--nav-active)}.ds-nav-active{border-color:var(--nav-muted);font-weight:650}.ds-nav-link:focus-visible{outline:2px solid var(--nav-text);outline-offset:1px}@media(max-width:840px){.ds-nav{flex-direction:row;overflow:auto;width:auto;padding:8px 12px}.ds-nav-link{padding:8px 12px;white-space:nowrap}}"
    },
    {
      "name": "Labeled run state",
      "kind": "chip",
      "refersTo": "run-status",
      "description": "Text carries the meaning of this outlined running state.",
      "html": "<span class=\"ds-state\">Running</span>",
      "css": ".ds-state{display:inline-block;font:600 12px/1.5 var(--sans,system-ui,sans-serif);padding:2px 8px;border:1px solid var(--line);border-radius:6px;color:var(--accent);background:var(--panel)}"
    },
    {
      "name": "Composed panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Shared header for panel identity and collapse.",
      "html": "<section class=\"ds-panel\"><div class=\"ds-panel-head\"><button class=\"ds-panel-title\" role=\"tab\" aria-selected=\"true\">Agents running</button><button class=\"ds-collapse\" aria-label=\"Collapse Agents running\" aria-expanded=\"true\"><svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"m4 6 4 4 4-4\"/></svg></button></div><div class=\"ds-panel-body\">No active runs.</div></section>",
      "css": ".ds-panel{font:14px/1.5 var(--sans,system-ui,sans-serif);color:var(--text);background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow:hidden}.ds-panel-head{display:flex;gap:8px;align-items:center;justify-content:space-between;padding:8px 12px;border-bottom:1px solid var(--line)}.ds-panel-title{font:600 13px/1.5 var(--sans,system-ui,sans-serif);min-height:34px;padding:6px 0;border:1px solid transparent;border-radius:6px;background:transparent;color:var(--text);cursor:pointer}.ds-panel-title:hover{border-color:var(--accent)}.ds-panel-title:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-collapse{display:grid;place-items:center;width:32px;height:32px;padding:6px;border:1px solid transparent;border-radius:6px;background:transparent;color:var(--text-dim);cursor:pointer}.ds-collapse svg{width:16px;height:16px;transition:transform 160ms ease}.ds-collapse[aria-expanded=false] svg{transform:rotate(-90deg)}.ds-collapse:hover{border-color:var(--accent)}.ds-collapse:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}.ds-panel-body{padding:16px}@media(max-width:760px){.ds-panel-body{padding:12px}}@media(prefers-reduced-motion:reduce){.ds-collapse svg{transition:none}}"
    },
    {
      "name": "Work identity row",
      "kind": "custom",
      "refersTo": null,
      "description": "Title, technical identity, state and wrapping evidence.",
      "html": "<article class=\"ds-work\"><div class=\"ds-work-main\"><a href=\"#run\">Update repository settings</a><small class=\"ds-work-id\">TASK-123</small><span class=\"ds-work-state\">Running</span></div><div class=\"ds-evidence\"><span>helmsman</span><span>2m elapsed</span></div></article>",
      "css": ".ds-work{display:grid;gap:8px;padding:12px 0;border-bottom:1px solid var(--line);font:14px/1.5 var(--sans,system-ui,sans-serif);color:var(--text);overflow-wrap:anywhere}.ds-work-main{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 12px;align-items:start}.ds-work-main>a{font:600 15px/1.45 var(--sans,system-ui,sans-serif);color:var(--text);text-decoration:none}.ds-work-main>a:hover{color:var(--accent);text-decoration:underline}.ds-work-main>a:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}.ds-work-id{grid-column:1;grid-row:2;font:12px/1.5 var(--mono,monospace);color:var(--text-dim)}.ds-work-state{grid-column:2;grid-row:1/3;align-self:start;padding:2px 8px;border:1px solid var(--line);border-radius:6px;font-size:12px;font-weight:600;color:var(--accent);background:var(--panel)}.ds-evidence{display:flex;flex-wrap:wrap;gap:4px 12px;color:var(--text-dim);font-size:12px}@media(max-width:480px){.ds-work-main{grid-template-columns:minmax(0,1fr)}.ds-work-state{grid-column:1;grid-row:3;justify-self:start}}"
    },
    {
      "name": "Run log",
      "kind": "custom",
      "refersTo": "run-log",
      "description": "Bounded, selectable neutral mono evidence.",
      "html": "<pre class=\"ds-log\" tabindex=\"0\">Reading repository configuration\nRunning checks…</pre>",
      "css": ".ds-log{max-height:420px;min-height:100px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;margin:0;padding:12px;background:var(--face,var(--panel));color:var(--text);border:1px solid var(--line);border-radius:6px;font:12px/1.6 var(--mono,monospace)}.ds-log:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}"
    }
  ],
  "narrative": {
    "northStar": "Field Guide",
    "overview": "Field Guide uses scientific field-guide classification to make work identifiable at a glance: task titles, compact labeled states and subordinate evidence. Evergreen navigation frames dark green-neutral work surfaces; restrained teal marks selection and action. Controls and text use system sans, with JetBrains Mono reserved for identifiers and logs.\n\nStandard web controls and the plugin composition model remain intact. Panels share an index-like rhythm of identity, state and aligned evidence; tab selection and collapse occupy one header row. The dark default palette applies to fresh installs, while existing user-selected palettes retain their colors. Motion provides bounded state feedback with reduced-motion support.",
    "keyCharacteristics": [
      "Evergreen navigation, dark green-neutral work surfaces and restrained teal selection.",
      "Task identity first, labeled state alongside it, supporting evidence below.",
      "System sans for controls and text; JetBrains Mono for identifiers and logs.",
      "Twelve-pixel panels and six-pixel controls, with native affordances.",
      "Customizable panels, logs within reach and a single-column small-screen reading order."
    ],
    "rules": [
      {
        "name": "The Theme Continuity Rule",
        "body": "Use semantic CSS properties for surfaces, text, selection and state. Dark Field Guide is the fresh-install default; a saved theme keeps its palette.",
        "section": "colors"
      },
      {
        "name": "The Identity First Rule",
        "body": "Give the task title priority, keep identifiers and evidence subordinate, and write the state as a label rather than relying on color alone.",
        "section": "typography"
      },
      {
        "name": "The Named Panel Rule",
        "body": "Within a named panel tab, visually hide a repeated local heading while keeping it available to assistive technology. Preserve the heading when the plugin is rendered standalone.",
        "section": "typography"
      },
      {
        "name": "The Flat Work Surface Rule",
        "body": "Separate work panels with neutral surface tone, spacing and thin borders. Reserve floating depth for the notification popover.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use semantic theme properties so existing palettes continue to work.",
      "Do present task titles, labeled states and subordinate evidence in the shared index-like rhythm.",
      "Do preserve the accessible heading when suppressing a repeated visible panel heading.",
      "Do keep tab selection and collapse together, and preserve saved panel order when adapting to a narrow screen.",
      "Do use visible focus outlines and honor reduced-motion preferences."
    ],
    "donts": [
      "Don't restore brushed-metal panels, seven-segment counts or the oscilloscope treatment as the default visual language.",
      "Don't use monospace as the general control or prose face.",
      "Don't use a status hue as the only way to identify state.",
      "Don't turn a viewport change into a saved layout edit."
    ]
  }
}
