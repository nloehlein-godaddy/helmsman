{
  "name": "helmsman",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:prompt-parity": "node --import tsx scripts/check-prompt-parity.mjs",
    "test:browser": "playwright test",
    "helmsman": "tsx server/helmsman/main.ts",
    "serve": "tsx server/helmsman/main.ts",
    "cmux:costs": "node scripts/cmux-codex-cost.mjs",
    "cmux:costs:install": "node scripts/install-cmux-codex-cost.mjs",
    "cmux:costs:uninstall": "node scripts/install-cmux-codex-cost.mjs --uninstall",
    "plugins": "tsx server/helmsman/plugins/cli.ts",
    "build:distribution": "npm run build && node scripts/build-distribution.mjs",
    "test:distribution": "npm run build:distribution && node --test scripts/distribution-check.mjs && playwright test --config playwright.distribution.config.ts",
    "slack:oi:check": "tsx server/helmsman/slack-oi-check.ts",
    "eval:prompts": "node --import tsx scripts/prompt-evaluation.mjs",
    "test:prompt-evaluation": "node --import tsx --test scripts/prompt-evaluation-check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "es-module-lexer": "^2.3.2"
  }
}
